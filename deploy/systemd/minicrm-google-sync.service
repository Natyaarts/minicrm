[Unit]
Description=minicrm Google Sheets auto-sync
After=network-online.target

[Service]
Type=oneshot
User=<same as reminders service>
WorkingDirectory=<same as reminders service>
EnvironmentFile=<same as reminders service>
ExecStart=/usr/bin/flock -n /tmp/minicrm-google-sync.lock <venv>/bin/python manage.py run_google_sync
TimeoutStartSec=240